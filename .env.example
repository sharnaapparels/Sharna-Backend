# Copy this to .env.example and fill in your own values

# ─── PORT ─────────────────────────────────────────────────────────────────────
# Railway auto-assigns PORT. Leave blank here.
PORT=5001
NODE_ENV=production

# ─── DATABASE (Neon PostgreSQL) ──────────────────────────────────────────────
# From your Neon dashboard — use the POOLED URL for DATABASE_URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require

# ─── AUTH ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_strong_random_secret_here
CLIENT_URL=https://your-frontend.vercel.app

# ─── RAZORPAY ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── CLOUDINARY ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── WHATSAPP ─────────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# ─── WISHLIST REMINDER ────────────────────────────────────────────────────────
WISHLIST_REMINDER_DAYS=3
